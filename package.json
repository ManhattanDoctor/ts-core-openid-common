{
    "name": "@ts-core/openid-common",
    "version": "1.0.53",
    "description": "TypeScript library for OpenID Connect authentication with Keycloak support. Provides token validation, role/resource authorization, and automatic token refresh.",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.57"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-openid-common.git"
    },
    "keywords": [
        "typescript",
        "openid",
        "openid-connect",
        "oidc",
        "keycloak",
        "authentication",
        "authorization",
        "oauth2",
        "jwt",
        "token",
        "sso",
        "identity",
        "access-control",
        "rbac",
        "security"
    ],
    "bugs": {
